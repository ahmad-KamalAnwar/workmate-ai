# Copy to .env and fill in. Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (docker compose builds DATABASE_URL from these)
POSTGRES_USER=workmate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=workmate

# Sessions (defaults shown). Set COOKIE_SECURE=true when served over HTTPS.
# COOKIE_SECURE=false
# SESSION_IDLE_TIMEOUT_MINUTES=10080
# SESSION_ABSOLUTE_TIMEOUT_MINUTES=43200
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_WINDOW_SECONDS=900
